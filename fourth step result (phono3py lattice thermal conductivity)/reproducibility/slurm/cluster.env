# Cluster-specific settings for the DRAC SLURM campaign.
# Sourced by every sbatch script and by submit_all.sh.
#
# EDIT BEFORE FIRST USE:
#   1. ACCOUNT  — the allocation string from CCDB (usually def-<professor>).
#   2. The quantumespresso module version — run `module spider quantumespresso`
#      on the cluster and pick an available 7.x version.

# Allocation to charge compute time to (CCDB: RAP asw-382-aa, group def-kleinke).
# Nibi splits SLURM accounts by resource: use the _cpu variant for this
# campaign (sacctmgr show assoc user=$USER lists the valid ones).
export ACCOUNT=def-kleinke_cpu

# Nibi has no default partition (submission fails without one). CPU jobs up
# to 12 h fit cpubase_bycore_b2; sbatch reads this env var automatically.
export SBATCH_PARTITION=cpubase_bycore_b2

# QE from the Alliance module system
module load StdEnv/2023 quantumespresso/7.3.1

# Pseudopotentials — same SSSP 1.3.0 PBE precision set as the laptop/WSL
# (download instructions in DRAC_SETUP.md; names must match qe/pseudo/manifest.md)
export SSSP_PBE_PRECISION="$HOME/pseudos/SSSP-1.3.0-PBE-precision"

# Python venv holding phonopy/phono3py/h5py — used by stage 2 only
# (creation instructions in DRAC_SETUP.md)
export P3_VENV="$HOME/venvs/p3"

# k-point pools for pw.x (same meaning as QE_NK on the laptop)
export QE_NK=2

# The Alliance QE module is an MPI + OpenMP hybrid build. Without an explicit
# thread cap each of the 32 MPI ranks spawned ~11 OpenMP threads on the
# 32-core allocation (pw.x banner: "running on 352 processor cores") and the
# 2026-08-03 stage0 job 19030260 timed out still on SCF iteration 7 of the
# first benchmark run. One thread per rank restores pure-MPI behavior.
export OMP_NUM_THREADS=1
