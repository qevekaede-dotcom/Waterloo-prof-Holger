# Shared DRAC/Nibi runtime for the phono3py campaign v2 SLURM templates.
#
# This file is sourced after SLURM starts a job.  Submission-time choices
# (account, partition overrides, array range, and dependencies) belong in the
# submission command, not here.  Scientific settings belong in the material's
# campaign configuration, not in this shared cluster file.

# submit.py uses an explicit export allow-list.  Clear shell/Python startup
# hooks defensively as well; none of these may select code or a runner.
unset BASH_ENV ENV CDPATH GLOBIGNORE PYTHONHOME PYTHONPATH
export PATH="/usr/local/bin:/usr/bin:/bin"
# submit.py deliberately gives sbatch a finite export allow-list.  Slurm carries
# that export policy into nested srun steps unless the job script resets it,
# which would hide the module and virtualenv environment assembled below from
# QE ranks.  Export the now-sanitized batch environment to every job step.
export SLURM_EXPORT_ENV="ALL"

P3_SLURM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
P3_CAMPAIGN_DIR="$(cd "$P3_SLURM_DIR/.." && pwd -P)"
P3_REPO_ROOT="$(cd "$P3_CAMPAIGN_DIR/../../.." && pwd -P)"
CAMPAIGN_CLI="$P3_CAMPAIGN_DIR/campaign.py"

# Resolve the scheduler account's real home from NSS, never from an inherited
# HOME value.  The two user-owned runtime directories are then fixed derivations
# of that trusted identity.  All executable/module knobs are literal, versioned
# policy in this file rather than caller-overridable defaults.
P3_ACCOUNT_UID="$(command -p id -u)"
P3_PASSWD_RECORD="$(command -p getent passwd "$P3_ACCOUNT_UID")"
IFS=: read -r _ _ _ _ _ P3_ACCOUNT_HOME _ <<< "$P3_PASSWD_RECORD"
[[ "$P3_ACCOUNT_HOME" == /* && "$P3_ACCOUNT_HOME" != "/" ]] \
    || { printf 'ERROR: cannot derive a safe scheduler-account home\n' >&2; exit 2; }
export HOME="$P3_ACCOUNT_HOME"
export STDENV_MODULE="StdEnv/2023"
export QE_MODULE="quantumespresso/7.3.1"
export P3_MODULE_INIT="/cvmfs/soft.computecanada.ca/config/profile/bash.sh"
# cluster.env intentionally resets PATH, while Nibi's Slurm client commands
# live outside that baseline. Use the stable Alliance Slurm symlink directly.
export P3_SACCT="/opt/software/slurm/bin/sacct"
export P3_VENV="$P3_ACCOUNT_HOME/venvs/p3"
export P3_PSEUDO_DIR="$P3_ACCOUNT_HOME/pseudos/SSSP-1.3.0-PBE-precision"
export QE_EXECUTABLE="pw.x"
export QE_MPI_LAUNCHER="srun"
export QE_NK="1"
[[ "${SLURM_CPUS_PER_TASK:-1}" =~ ^[1-9][0-9]*$ ]] \
    || { printf 'ERROR: SLURM_CPUS_PER_TASK is invalid\n' >&2; exit 2; }
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-1}"
export CAMPAIGN_CLI
readonly P3_SLURM_DIR P3_CAMPAIGN_DIR P3_REPO_ROOT CAMPAIGN_CLI
readonly P3_ACCOUNT_UID P3_PASSWD_RECORD P3_ACCOUNT_HOME HOME
readonly STDENV_MODULE QE_MODULE P3_MODULE_INIT P3_SACCT P3_VENV P3_PSEUDO_DIR
readonly QE_EXECUTABLE QE_MPI_LAUNCHER QE_NK OMP_NUM_THREADS
readonly SLURM_EXPORT_ENV

p3_die() {
    printf 'ERROR: %s\n' "$*" >&2
    return 2
}

p3_require_compute_node() {
    [[ -n "${SLURM_JOB_ID:-}" ]] || p3_die "this stage must run inside a SLURM job"
    [[ -n "${SLURM_SUBMIT_DIR:-}" ]] || p3_die "SLURM_SUBMIT_DIR is unavailable"
    [[ -n "${SLURM_JOB_NODELIST:-}" ]] || p3_die "SLURM_JOB_NODELIST is unavailable"
}

p3_require_file() {
    local label="$1"
    local path="$2"
    [[ -f "$path" ]] || p3_die "$label does not exist: $path"
}

p3_require_run_directory() {
    local relative="$1"
    local current="$RUN_DIR"
    local part
    [[ -n "$relative" && "$relative" != /* ]] \
        || p3_die "unsafe RUN_DIR-relative directory: $relative"
    IFS='/' read -r -a p3_path_parts <<< "$relative"
    for part in "${p3_path_parts[@]}"; do
        [[ -n "$part" && "$part" != "." && "$part" != ".." ]] \
            || p3_die "unsafe RUN_DIR path component: $relative"
        current="$current/$part"
        [[ ! -L "$current" ]] || p3_die "RUN_DIR path contains a symlink: $current"
        [[ -d "$current" ]] || p3_die "required RUN_DIR directory is missing: $current"
        [[ "$(cd "$current" && pwd -P)" == "$current" ]] \
            || p3_die "RUN_DIR directory escapes strict containment: $current"
    done
}

p3_ensure_run_directory() {
    local relative="$1"
    local current="$RUN_DIR"
    local part
    [[ -n "$relative" && "$relative" != /* ]] \
        || p3_die "unsafe RUN_DIR-relative directory: $relative"
    IFS='/' read -r -a p3_path_parts <<< "$relative"
    for part in "${p3_path_parts[@]}"; do
        [[ -n "$part" && "$part" != "." && "$part" != ".." ]] \
            || p3_die "unsafe RUN_DIR path component: $relative"
        current="$current/$part"
        [[ ! -L "$current" ]] || p3_die "RUN_DIR path contains a symlink: $current"
        if [[ ! -e "$current" ]]; then
            mkdir "$current" 2>/dev/null || true
        fi
        [[ ! -L "$current" && -d "$current" ]] \
            || p3_die "cannot create a safe RUN_DIR directory: $current"
        [[ "$(cd "$current" && pwd -P)" == "$current" ]] \
            || p3_die "RUN_DIR directory escapes strict containment: $current"
    done
}

p3_require_context() {
    : "${CAMPAIGN_CONFIG:?export CAMPAIGN_CONFIG as the material campaign JSON path}"
    : "${RUN_DIR:?export RUN_DIR as the already prepared immutable run directory}"
    : "${ATTEMPT_ID:?export ATTEMPT_ID as a new identifier for this submission attempt}"
    : "${P3_EXPECTED_CONFIG_SHA256:?submit.py must export the reviewed config hash}"
    : "${P3_SUBMIT_SCRIPT_SHA256:?submit.py must export its own workflow hash}"
    : "${P3_STAGE_SCRIPT_SHA256:?submit.py must export the stage-script hash}"
    : "${P3_CLUSTER_ENV_SHA256:?submit.py must export the cluster runtime hash}"
    : "${P3_CAMPAIGN_CLI_SHA256:?submit.py must export the campaign CLI hash}"

    [[ "$CAMPAIGN_CONFIG" == /* ]] \
        || p3_die "CAMPAIGN_CONFIG must be an absolute path"
    [[ "$RUN_DIR" == /* ]] || p3_die "RUN_DIR must be an absolute path"
    [[ "$RUN_DIR" != "/" && "$RUN_DIR" != "${HOME:?}" ]] \
        || p3_die "RUN_DIR is too broad to be a campaign run: $RUN_DIR"
    [[ "$RUN_DIR" != */READY_TO_ATTACH && "$RUN_DIR" != */READY_TO_ATTACH/* ]] \
        || p3_die "RUN_DIR must never be inside a frozen READY_TO_ATTACH record"

    p3_require_file "campaign config" "$CAMPAIGN_CONFIG"
    p3_require_file "campaign CLI" "$CAMPAIGN_CLI"
    [[ -d "$RUN_DIR" ]] || p3_die "run directory does not exist: $RUN_DIR"
    [[ "$ATTEMPT_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]] \
        || p3_die "ATTEMPT_ID must contain only letters, digits, dot, underscore, or hyphen"
    for p3_hash in \
        "$P3_EXPECTED_CONFIG_SHA256" \
        "$P3_SUBMIT_SCRIPT_SHA256" \
        "$P3_STAGE_SCRIPT_SHA256" \
        "$P3_CLUSTER_ENV_SHA256" \
        "$P3_CAMPAIGN_CLI_SHA256"; do
        [[ "$p3_hash" =~ ^[0-9a-f]{64}$ ]] \
            || p3_die "submission workflow/config hash is invalid"
    done

    CAMPAIGN_CONFIG="$(cd "$(dirname "$CAMPAIGN_CONFIG")" && pwd -P)/$(basename "$CAMPAIGN_CONFIG")"
    RUN_DIR="$(cd "$RUN_DIR" && pwd -P)"
    [[ "$(sha256sum "$CAMPAIGN_CONFIG" | awk '{print $1}')" == "$P3_EXPECTED_CONFIG_SHA256" ]] \
        || p3_die "campaign config differs from the reviewed submission"
    [[ "$(sha256sum "$CAMPAIGN_CLI" | awk '{print $1}')" == "$P3_CAMPAIGN_CLI_SHA256" ]] \
        || p3_die "campaign CLI differs from the submitted workflow"
    [[ "$(sha256sum "$P3_SLURM_DIR/cluster.env" | awk '{print $1}')" == "$P3_CLUSTER_ENV_SHA256" ]] \
        || p3_die "cluster runtime differs from the submitted workflow"
    [[ "$(sha256sum "$P3_CAMPAIGN_DIR/submit.py" | awk '{print $1}')" == "$P3_SUBMIT_SCRIPT_SHA256" ]] \
        || p3_die "submission frontend differs from the submitted workflow"
    export CAMPAIGN_CONFIG RUN_DIR ATTEMPT_ID
}

p3_finish_attempt() {
    local rc=$?
    trap - EXIT
    if [[ -n "${P3_ATTEMPT_DIR:-}" && -d "$P3_ATTEMPT_DIR" ]]; then
        printf '%s\n' "$rc" > "$P3_ATTEMPT_DIR/exit_code.txt"
        date -u +%Y-%m-%dT%H:%M:%SZ > "$P3_ATTEMPT_DIR/finished_utc.txt"
    fi
    exit "$rc"
}

p3_begin_attempt() {
    local stage="$1"
    local task_suffix="${2:-}"
    local stage_script
    local stage_root="$RUN_DIR/slurm_attempts/$stage"
    local attempt_root="$stage_root/$ATTEMPT_ID"

    case "$stage" in
        diagnostic) stage_script="$P3_SLURM_DIR/diagnostic.sbatch" ;;
        relax) stage_script="$P3_SLURM_DIR/relax.sbatch" ;;
        preflight) stage_script="$P3_SLURM_DIR/preflight.sbatch" ;;
        force) stage_script="$P3_SLURM_DIR/force_array.sbatch" ;;
        postprocess) stage_script="$P3_SLURM_DIR/postprocess.sbatch" ;;
        collect) stage_script="$P3_SLURM_DIR/collect.sbatch" ;;
        *) p3_die "unknown stage script identity: $stage" ;;
    esac
    p3_require_file "versioned stage script" "$stage_script"
    [[ "$(sha256sum "$stage_script" | awk '{print $1}')" == "$P3_STAGE_SCRIPT_SHA256" ]] \
        || p3_die "stage script differs from the submitted workflow"

    p3_ensure_run_directory "slurm_attempts/$stage"
    if [[ -n "$task_suffix" ]]; then
        # Several array tasks may race to make the common attempt root.
        p3_ensure_run_directory "slurm_attempts/$stage/$ATTEMPT_ID"
        P3_ATTEMPT_DIR="$attempt_root/$task_suffix"
    else
        P3_ATTEMPT_DIR="$attempt_root"
    fi

    # A resubmission must use a new ATTEMPT_ID.  This is the shell-level guard
    # that keeps a failed stdout/stderr record from being overwritten.
    mkdir "$P3_ATTEMPT_DIR" \
        || p3_die "attempt already exists; choose a new ATTEMPT_ID: $P3_ATTEMPT_DIR"
    export P3_ATTEMPT_DIR P3_ATTEMPT_ID="$ATTEMPT_ID"

    {
        printf 'stage\t%s\n' "$stage"
        printf 'attempt_id\t%s\n' "$ATTEMPT_ID"
        printf 'slurm_job_id\t%s\n' "${SLURM_JOB_ID:-}"
        printf 'slurm_array_job_id\t%s\n' "${SLURM_ARRAY_JOB_ID:-}"
        printf 'slurm_array_task_id\t%s\n' "${SLURM_ARRAY_TASK_ID:-}"
        printf 'slurm_job_account\t%s\n' "${SLURM_JOB_ACCOUNT:-}"
        printf 'slurm_job_partition\t%s\n' "${SLURM_JOB_PARTITION:-}"
        printf 'slurm_job_num_nodes\t%s\n' "${SLURM_JOB_NUM_NODES:-}"
        printf 'slurm_ntasks\t%s\n' "${SLURM_NTASKS:-}"
        printf 'slurm_cpus_per_task\t%s\n' "${SLURM_CPUS_PER_TASK:-}"
        printf 'slurm_mem_per_cpu\t%s\n' "${SLURM_MEM_PER_CPU:-}"
        printf 'slurm_timelimit\t%s\n' "${SLURM_TIMELIMIT:-}"
        printf 'host\t%s\n' "$(hostname -f 2>/dev/null || hostname)"
        printf 'started_utc\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'config\t%s\n' "$CAMPAIGN_CONFIG"
        printf 'config_sha256\t%s\n' "$(sha256sum "$CAMPAIGN_CONFIG" | awk '{print $1}')"
        printf 'campaign_cli\t%s\n' "$CAMPAIGN_CLI"
        printf 'campaign_cli_sha256\t%s\n' "$(sha256sum "$CAMPAIGN_CLI" | awk '{print $1}')"
        printf 'submit_script_sha256\t%s\n' "$P3_SUBMIT_SCRIPT_SHA256"
        printf 'stage_script_sha256\t%s\n' "$P3_STAGE_SCRIPT_SHA256"
        printf 'cluster_env_sha256\t%s\n' "$P3_CLUSTER_ENV_SHA256"
        printf 'p3_account_uid\t%s\n' "$P3_ACCOUNT_UID"
        printf 'p3_account_home\t%s\n' "$P3_ACCOUNT_HOME"
        printf 'stdenv_module\t%s\n' "$STDENV_MODULE"
        printf 'qe_module\t%s\n' "$QE_MODULE"
        printf 'p3_venv\t%s\n' "$P3_VENV"
        printf 'p3_pseudo_dir\t%s\n' "$P3_PSEUDO_DIR"
        printf 'qe_executable\t%s\n' "$QE_EXECUTABLE"
        printf 'qe_mpi_launcher\t%s\n' "$QE_MPI_LAUNCHER"
        printf 'qe_nk\t%s\n' "$QE_NK"
        printf 'omp_num_threads\t%s\n' "$OMP_NUM_THREADS"
        printf 'run_dir\t%s\n' "$RUN_DIR"
        if [[ -n "${P3_DIAGNOSTIC_RESOURCE_SHA256:-}" ]]; then
            printf 'diagnostic_resource_sha256\t%s\n' \
                "$P3_DIAGNOSTIC_RESOURCE_SHA256"
            printf 'diagnostic_requested_walltime_minutes\t%s\n' \
                "${P3_DIAGNOSTIC_REQUESTED_WALLTIME_MINUTES:-}"
            if [[ -n "${SLURM_TIMELIMIT:-}" ]]; then
                printf 'diagnostic_time_limit_source\t%s\n' 'native_slurm_timelimit'
            else
                printf 'diagnostic_time_limit_source\t%s\n' 'submitted_request_export'
            fi
            printf 'diagnostic_lineage_sha256\t%s\n' \
                "${P3_DIAGNOSTIC_LINEAGE_SHA256:-}"
            printf 'diagnostic_backend_sha256\t%s\n' \
                "${P3_DIAGNOSTIC_BACKEND_SHA256:-}"
        fi
        if [[ -n "${P3_PREFLIGHT_CANDIDATE_IDS:-}" ]]; then
            printf 'preflight_candidate_ids\t%s\n' "$P3_PREFLIGHT_CANDIDATE_IDS"
            printf 'preflight_candidate_subset_sha256\t%s\n' \
                "${P3_PREFLIGHT_CANDIDATE_SHA256:-}"
        fi
        if [[ -n "${PRIMARY_STAGE:-}" ]]; then
            printf 'primary_stage\t%s\n' "$PRIMARY_STAGE"
            printf 'primary_attempt_id\t%s\n' "${PRIMARY_ATTEMPT_ID:-}"
            printf 'primary_job_id\t%s\n' "${PRIMARY_JOB_ID:-}"
            printf 'primary_request_sha256\t%s\n' "${PRIMARY_REQUEST_SHA256:-}"
            printf 'primary_result_sha256\t%s\n' "${PRIMARY_RESULT_SHA256:-}"
            printf 'primary_stage_script_sha256\t%s\n' \
                "${PRIMARY_STAGE_SCRIPT_SHA256:-}"
        fi
        printf 'git_commit\t%s\n' "$(git -C "$P3_REPO_ROOT" rev-parse HEAD 2>/dev/null || true)"
    } > "$P3_ATTEMPT_DIR/context.tsv"

    exec > >(tee "$P3_ATTEMPT_DIR/stdout.log") \
         2> >(tee "$P3_ATTEMPT_DIR/stderr.log" >&2)
    trap p3_finish_attempt EXIT
}

p3_load_qe() {
    local p3_errexit_was_enabled=0
    local p3_module_init_rc=0
    local p3_nounset_was_enabled=0

    p3_require_file "Alliance module initialization" "$P3_MODULE_INIT"
    case $- in
        *e*) p3_errexit_was_enabled=1 ;;
    esac
    case $- in
        *u*) p3_nounset_was_enabled=1 ;;
    esac
    # The Alliance profile reads optional variables such as SKIP_CC_CVMFS
    # without default expansion.  SLURM stages deliberately use `set -u`, so
    # temporarily disable nounset only while sourcing that external profile
    # and restore the caller's setting immediately afterwards.
    set +eu
    # shellcheck disable=SC1090
    source "$P3_MODULE_INIT"
    p3_module_init_rc=$?
    if (( p3_errexit_was_enabled )); then
        set -e
    else
        set +e
    fi
    if (( p3_nounset_was_enabled )); then
        set -u
    else
        set +u
    fi
    if (( p3_module_init_rc != 0 )); then
        p3_die "Alliance module initialization failed: $P3_MODULE_INIT"
        return 2
    fi
    command -v module >/dev/null 2>&1 || p3_die "Alliance module command is unavailable"
    module --force purge
    module load "$STDENV_MODULE" "$QE_MODULE"
    command -v "$QE_EXECUTABLE" >/dev/null 2>&1 \
        || p3_die "QE executable not found after module load: $QE_EXECUTABLE"
    command -v "$QE_MPI_LAUNCHER" >/dev/null 2>&1 \
        || p3_die "MPI launcher not found: $QE_MPI_LAUNCHER"
}

p3_activate_python() {
    p3_require_file "phono3py virtualenv activation script" "$P3_VENV/bin/activate"
    # shellcheck disable=SC1090
    source "$P3_VENV/bin/activate"
    command -v python >/dev/null 2>&1 || p3_die "python is unavailable in $P3_VENV"
    [[ "$(command -v python)" == "$P3_VENV/bin/python" ]] \
        || p3_die "activated python does not come from the fixed phono3py virtualenv"
}

p3_run_cli() {
    local command="$1"
    shift
    python "$CAMPAIGN_CLI" "$command" \
        --config "$CAMPAIGN_CONFIG" \
        --run-dir "$RUN_DIR" \
        "$@"
}
