# Shared DRAC/Nibi runtime for the phono3py campaign v2 SLURM templates.
#
# This file is sourced after SLURM starts a job.  Submission-time choices
# (account, partition overrides, array range, and dependencies) belong in the
# submission command, not here.  Scientific settings belong in the material's
# campaign configuration, not in this shared cluster file.

# Alliance software environment verified on Nibi in September 2026.
export STDENV_MODULE="${STDENV_MODULE:-StdEnv/2023}"
export QE_MODULE="${QE_MODULE:-quantumespresso/7.3.1}"
export P3_VENV="${P3_VENV:-${HOME:?}/venvs/p3}"
export P3_PSEUDO_DIR="${P3_PSEUDO_DIR:-${HOME:?}/pseudos/SSSP-1.3.0-PBE-precision}"

# Runtime knobs.  A material configuration remains the authority for cutoffs,
# k meshes, structures, pseudopotentials, and every scientific threshold.
export QE_EXECUTABLE="${QE_EXECUTABLE:-pw.x}"
export QE_MPI_LAUNCHER="${QE_MPI_LAUNCHER:-srun}"
export QE_NK="${QE_NK:-1}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"

P3_SLURM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
P3_CAMPAIGN_DIR="$(cd "$P3_SLURM_DIR/.." && pwd -P)"
P3_REPO_ROOT="$(cd "$P3_CAMPAIGN_DIR/../../.." && pwd -P)"
export CAMPAIGN_CLI="${CAMPAIGN_CLI:-$P3_CAMPAIGN_DIR/campaign.py}"

p3_die() {
    printf 'ERROR: %s\n' "$*" >&2
    return 2
}

p3_require_compute_node() {
    [[ -n "${SLURM_JOB_ID:-}" ]] || p3_die "this stage must run inside a SLURM job"
    [[ -n "${SLURM_SUBMIT_DIR:-}" ]] || p3_die "SLURM_SUBMIT_DIR is unavailable"
    [[ -n "${SLURM_JOB_NODELIST:-}" ]] || p3_die "SLURM_JOB_NODELIST is unavailable"
}

p3_require_file() {
    local label="$1"
    local path="$2"
    [[ -f "$path" ]] || p3_die "$label does not exist: $path"
}

p3_require_context() {
    : "${CAMPAIGN_CONFIG:?export CAMPAIGN_CONFIG as the material campaign JSON path}"
    : "${RUN_DIR:?export RUN_DIR as the already prepared immutable run directory}"
    : "${ATTEMPT_ID:?export ATTEMPT_ID as a new identifier for this submission attempt}"

    [[ "$CAMPAIGN_CONFIG" == /* ]] \
        || p3_die "CAMPAIGN_CONFIG must be an absolute path"
    [[ "$RUN_DIR" == /* ]] || p3_die "RUN_DIR must be an absolute path"
    [[ "$RUN_DIR" != "/" && "$RUN_DIR" != "${HOME:?}" ]] \
        || p3_die "RUN_DIR is too broad to be a campaign run: $RUN_DIR"
    [[ "$RUN_DIR" != */READY_TO_ATTACH && "$RUN_DIR" != */READY_TO_ATTACH/* ]] \
        || p3_die "RUN_DIR must never be inside a frozen READY_TO_ATTACH record"

    p3_require_file "campaign config" "$CAMPAIGN_CONFIG"
    p3_require_file "campaign CLI" "$CAMPAIGN_CLI"
    [[ -d "$RUN_DIR" ]] || p3_die "run directory does not exist: $RUN_DIR"
    [[ "$ATTEMPT_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]] \
        || p3_die "ATTEMPT_ID must contain only letters, digits, dot, underscore, or hyphen"

    CAMPAIGN_CONFIG="$(cd "$(dirname "$CAMPAIGN_CONFIG")" && pwd -P)/$(basename "$CAMPAIGN_CONFIG")"
    RUN_DIR="$(cd "$RUN_DIR" && pwd -P)"
    export CAMPAIGN_CONFIG RUN_DIR ATTEMPT_ID
}

p3_finish_attempt() {
    local rc=$?
    trap - EXIT
    if [[ -n "${P3_ATTEMPT_DIR:-}" && -d "$P3_ATTEMPT_DIR" ]]; then
        printf '%s\n' "$rc" > "$P3_ATTEMPT_DIR/exit_code.txt"
        date -u +%Y-%m-%dT%H:%M:%SZ > "$P3_ATTEMPT_DIR/finished_utc.txt"
    fi
    exit "$rc"
}

p3_begin_attempt() {
    local stage="$1"
    local task_suffix="${2:-}"
    local stage_root="$RUN_DIR/slurm_attempts/$stage"
    local attempt_root="$stage_root/$ATTEMPT_ID"

    mkdir -p "$stage_root"
    if [[ -n "$task_suffix" ]]; then
        # Several array tasks may race to make the common attempt root.
        mkdir -p "$attempt_root"
        P3_ATTEMPT_DIR="$attempt_root/$task_suffix"
    else
        P3_ATTEMPT_DIR="$attempt_root"
    fi

    # A resubmission must use a new ATTEMPT_ID.  This is the shell-level guard
    # that keeps a failed stdout/stderr record from being overwritten.
    mkdir "$P3_ATTEMPT_DIR" \
        || p3_die "attempt already exists; choose a new ATTEMPT_ID: $P3_ATTEMPT_DIR"
    export P3_ATTEMPT_DIR P3_ATTEMPT_ID="$ATTEMPT_ID"

    {
        printf 'stage\t%s\n' "$stage"
        printf 'attempt_id\t%s\n' "$ATTEMPT_ID"
        printf 'slurm_job_id\t%s\n' "${SLURM_JOB_ID:-}"
        printf 'slurm_array_job_id\t%s\n' "${SLURM_ARRAY_JOB_ID:-}"
        printf 'slurm_array_task_id\t%s\n' "${SLURM_ARRAY_TASK_ID:-}"
        printf 'host\t%s\n' "$(hostname -f 2>/dev/null || hostname)"
        printf 'started_utc\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'config\t%s\n' "$CAMPAIGN_CONFIG"
        printf 'config_sha256\t%s\n' "$(sha256sum "$CAMPAIGN_CONFIG" | awk '{print $1}')"
        printf 'campaign_cli\t%s\n' "$CAMPAIGN_CLI"
        printf 'campaign_cli_sha256\t%s\n' "$(sha256sum "$CAMPAIGN_CLI" | awk '{print $1}')"
        printf 'run_dir\t%s\n' "$RUN_DIR"
        printf 'git_commit\t%s\n' "$(git -C "$P3_REPO_ROOT" rev-parse HEAD 2>/dev/null || true)"
    } > "$P3_ATTEMPT_DIR/context.tsv"

    exec > >(tee "$P3_ATTEMPT_DIR/stdout.log") \
         2> >(tee "$P3_ATTEMPT_DIR/stderr.log" >&2)
    trap p3_finish_attempt EXIT
}

p3_load_qe() {
    command -v module >/dev/null 2>&1 || p3_die "Alliance module command is unavailable"
    [[ -d "$P3_PSEUDO_DIR" ]] \
        || p3_die "pseudopotential directory not found: $P3_PSEUDO_DIR"
    module load "$STDENV_MODULE" "$QE_MODULE"
    command -v "$QE_EXECUTABLE" >/dev/null 2>&1 \
        || p3_die "QE executable not found after module load: $QE_EXECUTABLE"
    command -v "$QE_MPI_LAUNCHER" >/dev/null 2>&1 \
        || p3_die "MPI launcher not found: $QE_MPI_LAUNCHER"
}

p3_activate_python() {
    p3_require_file "phono3py virtualenv activation script" "$P3_VENV/bin/activate"
    # shellcheck disable=SC1090
    source "$P3_VENV/bin/activate"
    command -v python >/dev/null 2>&1 || p3_die "python is unavailable in $P3_VENV"
}

p3_run_cli() {
    local command="$1"
    shift
    python "$CAMPAIGN_CLI" "$command" \
        --config "$CAMPAIGN_CONFIG" \
        --run-dir "$RUN_DIR" \
        "$@"
}
